# Platform service ports
BACKEND_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_RELOAD=false
DATABASE_URL=postgresql+asyncpg://fms:fms_password@postgres:5432/fms
JWT_SECRET=phase-1-development-secret-change-me-32-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MQTT_INGESTION_ENABLED=true
MQTT_HOST=mqtt
MQTT_USERNAME=fms_demo
MQTT_PASSWORD=fms_demo_password
MQTT_TOPIC_FILTER=gps/+

# PostgreSQL
POSTGRES_DB=fms
POSTGRES_USER=fms
POSTGRES_PASSWORD=fms_password

# Web
VITE_API_BASE_URL=http://localhost:8000
CHOKIDAR_USEPOLLING=true

# Mobile local development
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_MQTT_WS_URL=ws://localhost:9001
EXPO_PUBLIC_MQTT_USERNAME=fms_demo
EXPO_PUBLIC_MQTT_PASSWORD=fms_demo_password

# Demo seed data
DEMO_PASSWORD=password123
DEMO_ADMIN_ACCOUNT=admin001
DEMO_OPERATOR_ACCOUNT=operator001
DEMO_DRIVER_ACCOUNT=driver001
DEMO_ADMIN_USER_ID=00000000-0000-0000-0000-000000000001
DEMO_OPERATOR_USER_ID=00000000-0000-0000-0000-000000000002
DEMO_DRIVER_USER_ID=00000000-0000-0000-0000-000000000003
DEMO_TRACKING_REF_ID=00000000-0000-0000-0000-000000000101
DEMO_TRACKING_REF_LABEL=ABC-1234
DEMO_DEVICE_IDENTIFIER=demo-device-001
