# Platform service ports
BACKEND_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
MQTT_PORT=1883

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_RELOAD=false
DATABASE_URL=postgresql+asyncpg://fms:fms_password@postgres:5432/fms
JWT_SECRET=phase-1-development-secret-change-me-32-bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MQTT_INGESTION_ENABLED=true
MQTT_HOST=mqtt
MQTT_USERNAME=fms_demo
MQTT_PASSWORD=fms_demo_password
MQTT_TOPIC_FILTER=gps/+

# PostgreSQL
POSTGRES_DB=fms
POSTGRES_USER=fms
POSTGRES_PASSWORD=fms_password

# Web
VITE_API_BASE_URL=http://localhost:8000

# Mobile local development
API_BASE_URL=http://localhost:8000
MOBILE_MQTT_HOST=localhost
MOBILE_MQTT_PORT=1883
MOBILE_MQTT_USERNAME=fms_demo
MOBILE_MQTT_PASSWORD=fms_demo_password
